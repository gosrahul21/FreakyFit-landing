# FreakyFit Landing Page Configuration

# Website Theme Configuration
# Options: "light" | "dark" (Default: "dark")
NEXT_PUBLIC_THEME=light

# TrueMind Labs Sanity Studio & CMS Configuration
# Project ID: bsplxesb
# Studio URL: https://truemindlabs.sanity.studio
NEXT_PUBLIC_SANITY_PROJECT_ID=bsplxesb
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Multi-tenant domain filter for TrueMind Labs Sanity Studio
# Posts tagged with this domain in TrueMind Labs Studio are fetched
DOMAIN_NAME=freakyfit.truemindlabs.com

# CDN Cache Duration (Default: 86400 seconds / 24 hours)
# Change to 3600 (1 hour) or your preferred duration.
# Set SANITY_REVALIDATE_SECRET for on-demand webhook invalidation.
SANITY_REVALIDATE_SECONDS=86400
SANITY_REVALIDATE_SECRET=your_optional_revalidate_secret_here

